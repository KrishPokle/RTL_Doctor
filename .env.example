# Settings for the portal's chat model. Copy this file to .env (git ignores .env) and fill it in.
# Leave LLM_BASE_URL empty to use the built-in stand-in, which only runs the tools.

# The API's address: what /chat/completions is added to.
# For TAMU AI Chat that is https://chat-api.tamu.ai/api
LLM_BASE_URL=
LLM_API_KEY=
# The model, spelled as the API lists it. Fill in the two lines above, then run
#   python -m portal.llm
# to see the names to choose from. The model has to support tool calling.
LLM_MODEL=
